# Network
NETWORK=devnet

# Solinfra RPC
RPC_URL=https://your-rpc-endpoint-here
RPC_WEBSOCKET_URL=wss://your-websocket-endpoint-here

# Solinfra gRPC
GRPC_URL=your-grpc-endpoint-here
GRPC_TOKEN=your-grpc-token-here

# Jito
JITO_BLOCK_ENGINE_URL=mainnet.block-engine.jito.wtf
JITO_TIP_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Wallet
WALLET_KEYPAIR_PATH=./keypair.json

# Tip Settings
TIP_MIN_LAMPORTS=1000
TIP_MAX_LAMPORTS=1000000

# Retry Settings
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Timeouts
CONFIRMATION_TIMEOUT_MS=60000
BLOCKHASH_EXPIRY_SLOTS=150
